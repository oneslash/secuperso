{
  "name": "secuperso",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "macos": "react-native run-macos",
    "start": "react-native start",
    "start:macos": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^11.2.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-native/metro-config": "^0.85.1",
    "@react-navigation/bottom-tabs": "^7.3.12",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.12",
    "@shopify/flash-list": "^2.0.1",
    "react": "19.0.0",
    "react-native": "^0.79.2",
    "react-native-config": "^1.5.5",
    "react-native-keychain": "^9.2.3",
    "react-native-macos": "^0.79.4",
    "react-native-reanimated": "^3.17.5",
    "react-native-safe-area-context": "^5.4.1",
    "react-native-screens": "4.10.0",
    "react-native-vector-icons": "^10.2.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/runtime": "^7.27.1",
    "@react-native-community/cli": "^18.0.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react-test-renderer": "19.0.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "react-native",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "Fixtures/"
    ],
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@data/(.*)$": "<rootDir>/src/data/$1",
      "^@ui/(.*)$": "<rootDir>/src/ui/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@app/(.*)$": "<rootDir>/src/app/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|zustand|@op-engineering|react-native-keychain)/)"
    ]
  }
}
